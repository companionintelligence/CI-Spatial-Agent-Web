{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "workspace": [
    "./packages/core",
    "./apps/web",
    "./apps/vision-pro",
    "./apps/proxy"
  ],
  "nodeModulesDir": "manual",
  "tasks": {
    "dev:web": "deno task --cwd apps/web dev",
    "dev:vision": "deno task --cwd apps/vision-pro dev",
    "dev:proxy": "deno task --cwd apps/proxy dev",
    "build": "deno task --cwd apps/web build && deno task --cwd apps/vision-pro build && deno task --cwd apps/proxy build",
    "lint": "deno task --cwd packages/core lint && deno task --cwd apps/web lint && deno task --cwd apps/vision-pro lint && deno task --cwd apps/proxy lint",
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    "test:coverage": "deno run -A npm:vitest run --coverage",
    "storybook": "deno task --cwd apps/web storybook",
    "build-storybook": "deno task --cwd apps/web build-storybook",
    "test:e2e": "deno run -A npm:playwright test",
    "test:e2e:ui": "deno run -A npm:playwright test --ui",
    "test:e2e:headed": "deno run -A npm:playwright test --headed",
    "test:e2e:debug": "deno run -A npm:playwright test --debug",
    "test:agent": "deno run -A npm:playwright test tests/agent.spec.ts",
    "test:audio": "deno run -A npm:playwright test tests/audio.spec.ts",
    "test:animation": "deno run -A npm:playwright test tests/animation.spec.ts",
    "test:l5": "deno run -A npm:playwright test -c playwright.config.capture.ts tests/render-matrix.spec.ts",
    "test:l4": "deno run -A npm:playwright test -c playwright.config.capture.ts tests/scenarios",
    "test:capture": "deno run -A npm:playwright test -c playwright.config.capture.ts",
    "test:report": "deno run -A npm:playwright show-report playwright-report",
    "format": "deno run -A npm:prettier --write \"**/*.{ts,tsx,json,md}\""
  }
}
