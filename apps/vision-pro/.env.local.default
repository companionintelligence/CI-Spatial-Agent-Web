
#Renderer Configuration
VITE_WEBGPU_ENABLED=true

# Audio Service Configuration
VITE_VAD_THRESHOLD=0.8
VITE_AUDIO_VOLUME=1.0
VITE_VAD_ENABLED=true

# TTS Service Configuration
VITE_TTS_VOICE=echo #en_US-hfc_female-medium
VITE_TTS_SPEED=1.0
VITE_TTS_PITCH=1.0
VITE_TTS_VOLUME=1.0
VITE_TTS_MODE=remote
VITE_TTS_API_KEY=
VITE_TTS_URL=https://api.openai.com/v1/audio/speech
VITE_TTS_MODEL=tts-1
VITE_TTS_STABILITY=0.5
VITE_TTS_SIMILARITY_BOOST=0.8

# STT Service Configuration
VITE_STT_LANGUAGE=en-US
VITE_STT_CONTINUOUS=true
VITE_STT_REMOTE=true
VITE_STT_API_KEY=

# LLM Service Configuration
VITE_LLM_PROVIDER=openai
VITE_LLM_LOCAL_MODEL=Llama-3.2-3B-Instruct-q4f16_1-MLC
VITE_LLM_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VITE_LLM_OPENAI_API_KEY=
VITE_LLM_OPENAI_MODEL=gpt-3.5-turbo
VITE_LLM_OLLAMA_API_URL=http://localhost:11434
VITE_LLM_OLLAMA_MODEL=llama3.2
VITE_LLM_SYSTEM_PROMPT=You are a helpful AI assistant with a friendly personality. You are embodied as a 3D avatar and can speak your responses out loud.\n\nKey behaviors:\n- Keep responses conversational and natural\n- Break longer responses into shorter sentences for better speech synthesis\n- Be engaging and personable in your interactions\n- Respond helpfully to questions and requests\n- If someone says "stop", they are interrupting you - acknowledge this briefly\n\nRemember: Your responses will be spoken aloud, so write in a way that sounds natural when spoken.

# Additional API Configurations
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
VITE_FLOWISE_API_URL=http://localhost:3000/api/v1/prediction/your-chatflow-id

XR_DEV_SERVER=http://localhost:5173/webspatial/avp
XR_PRE_SERVER=
XR_PROD_SERVER=
XR_BUNDLE_ID=
XR_TEAM_ID=
XR_VERSION=
XR_DEV_NAME=
XR_DEV_PASSWORD=
