{
  "name": "@ci-avatar/vision-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/pack-assets.mjs vision-pro",
    "dev": "vite",
    "predev:avp": "node ../../scripts/pack-assets.mjs vision-pro",
    "dev:avp": "XR_ENV=avp vite",
    "predev:avp:host": "node ../../scripts/pack-assets.mjs vision-pro",
    "dev:avp:host": "XR_ENV=avp vite --host",
    "prebuild": "node ../../scripts/pack-assets.mjs vision-pro",
    "build": "vite build",
    "prepreview": "node ../../scripts/pack-assets.mjs vision-pro",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "run:avp": "dotenv -e .env.local -- sh -c 'XR_ENV=avp webspatial-builder run --base=$XR_DEV_SERVER'",
    "build:avp": "dotenv -e .env.local -- sh -c 'XR_ENV=avp webspatial-builder build --base=$XR_PRE_SERVER --bundle-id=$XR_BUNDLE_ID --teamId=$XR_TEAM_ID'",
    "publish:avp": "dotenv -e .env.local -- sh -c 'XR_ENV=avp webspatial-builder publish --base=$XR_PROD_SERVER --bundle-id=$XR_BUNDLE_ID --teamId=$XR_TEAM_ID --version=$XR_VERSION --u=$XR_DEV_NAME --p=$XR_DEV_PASSWORD'"
  },
  "dependencies": {
    "@ci-avatar/core": "workspace:*",
    "@hexafield/simple-store": "^1.0.1",
    "@webspatial/core-sdk": "^1.0.5",
    "@webspatial/react-sdk": "^1.0.5",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.2",
    "three": "^0.182.0",
    "@ci-avatar/engine": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@webspatial/builder": "^1.0.5",
    "@webspatial/platform-visionos": "^1.0.5",
    "@webspatial/vite-plugin": "^0.1.9",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.32.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vite-plugin-html": "^3.2.2"
  }
}
