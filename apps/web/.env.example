VITE_LLM_PROVIDER=ollama
VITE_LLM_OLLAMA_API_URL=https://your-tunnel.trycloudflare.com
VITE_LLM_OLLAMA_MODEL=gemma3:1b

# Error reporting (Sentry) — opt-out. Set a DSN and reporting is on unless the
# user turns it off; leave it unset and no Sentry code initialises and the SDK is
# tree-shaken out of the bundle entirely — the absence of configuration, not a
# privacy setting, and what a source checkout gets.
# BUILD-TIME value: Vite bakes it into the bundle, so it must be set when
# `pnpm --filter @ci-avatar/web build` runs, not at container start.
# The browser still asks the BFF (`GET /api/config/telemetry`) for consent
# before initialising and fails closed, so `CI_TELEMETRY=off` on the proxy
# container turns reporting off without a rebuild — that endpoint is the only way
# an operator's "off" reaches a bundle with a DSN already baked in.
# See docs/operations/error-reporting.md.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project-id>
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=ci-spatial-companion-webxr@0.1.0
