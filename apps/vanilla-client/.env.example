# Dev-server proxy targets (copy to .env and adjust).

# OpenAI-compatible AI backend (chat completions + audio endpoints).
# Companion Intelligence server, Ollama, llama.cpp, vLLM, speaches, OpenAI…
AI_PROXY_TARGET=http://localhost:11434

# Grounding DINO object-detection server (server/main.py).
DETECT_PROXY_TARGET=http://localhost:8000

# Plain Piper HTTP TTS server (only when speech.ttsMode = 'piper').
TTS_PROXY_TARGET=http://localhost:5000
