node_modules/
dist/
.env.local
*.log
.tmp/
storybook-static/
coverage/
.claude/worktrees/

# Packed avatar/environment media. Single source of truth is /assets/{avatars,animations,props};
# these per-app copies are regenerated by scripts/pack-assets.mjs on predev/prebuild.
apps/*/public/assets/avatars/
apps/*/public/assets/animations/
apps/*/public/assets/props/

# Runtime LLM config. In the container nginx/40-render-config.sh writes this
# from env at boot; locally it is hand-written per environment. loadRuntimeConfig
# resolves to {} when it is absent, so nothing needs a committed copy.
apps/*/public/config.json

# Playwright visual-matrix artifacts: regenerated on every capture run.
docs/visual-tests/shots/*-verified.png
