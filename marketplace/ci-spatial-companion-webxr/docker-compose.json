{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "ci-spatial-companion-webxr",
      "image": "ghcr.io/companionintelligence/ci-spatial-companion-webxr:latest",
      "internalPort": 5173,
      "isMain": true,
      "addToMainNetwork": true,
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ],
      "environment": [
        {
          "key": "APP_LLM_PROVIDER",
          "value": "proxy"
        },
        {
          "key": "APP_PROXY_URL",
          "value": "/api/chat"
        },
        {
          "key": "APP_LLM_MODEL",
          "value": "${APP_LLM_MODEL}"
        },
        {
          "key": "CI_TELEMETRY",
          "value": "${CI_TELEMETRY}"
        },
        {
          "key": "APP_TTS_MODE",
          "value": "headtts"
        },
        {
          "key": "APP_STT_REMOTE",
          "value": "true"
        }
      ]
    },
    {
      "name": "proxy",
      "image": "ghcr.io/companionintelligence/ci-spatial-companion-proxy:latest",
      "internalPort": 8787,
      "addToMainNetwork": true,
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ],
      "environment": [
        {
          "key": "APP_UPSTREAM",
          "value": "ollama"
        },
        {
          "key": "APP_OLLAMA_URL",
          "value": "${APP_OLLAMA_URL}"
        },
        {
          "key": "APP_OLLAMA_MODEL",
          "value": "${APP_LLM_MODEL}"
        },
        {
          "key": "CI_TELEMETRY",
          "value": "${CI_TELEMETRY}"
        },
        {
          "key": "APP_TTS_UPSTREAM",
          "value": "headtts"
        },
        {
          "key": "APP_TTS_URL",
          "value": "http://headtts:8080"
        },
        {
          "key": "APP_TTS_VOICE",
          "value": "${APP_TTS_VOICE}"
        },
        {
          "key": "APP_STT_URL",
          "value": "http://whisper:8081"
        }
      ]
    },
    {
      "name": "headtts",
      "image": "ghcr.io/companionintelligence/ci-headtts:latest",
      "internalPort": 8080,
      "addToMainNetwork": true,
      "environment": [
        {
          "key": "HEADTTS_VOICE",
          "value": "${APP_TTS_VOICE}"
        },
        {
          "key": "CI_TELEMETRY",
          "value": "${CI_TELEMETRY}"
        }
      ]
    },
    {
      "name": "whisper",
      "image": "ghcr.io/companionintelligence/ci-whisper:latest",
      "internalPort": 8081,
      "addToMainNetwork": true,
      "environment": [
        {
          "key": "WHISPER_MODEL",
          "value": "Systran/faster-whisper-small"
        }
      ]
    }
  ]
}
