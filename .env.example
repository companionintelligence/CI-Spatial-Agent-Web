# Environment variables for LLM configuration
# Copy this to .env.local and fill in your API keys

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Anthropic Claude API Configuration  
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# Local LLM Configuration
VITE_LOCAL_LLM_ENABLED=true
VITE_DEFAULT_LOCAL_MODEL=Llama-3.1-8B-Instruct-q4f32_1-MLC

# Other API configurations (Ollama, etc.)
VITE_OLLAMA_API_URL=http://localhost:11434/api/chat
VITE_FLOWISE_API_URL=http://localhost:3000/api/v1/prediction/your-chatflow-id
